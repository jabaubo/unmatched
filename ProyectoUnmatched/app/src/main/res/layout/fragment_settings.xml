<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#424242"
    tools:context=".ui.settings.SettingsFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toTopOf="@+id/bt_settings_set"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="6"
        tools:listitem="@layout/set_layout" />

    <Button
        android:id="@+id/bt_settings_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sets"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rv_settings" />

    <Button
        android:id="@+id/bt_settings_personajes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:text="Personajes"
        app:layout_constraintBottom_toBottomOf="@+id/bt_settings_set"
        app:layout_constraintEnd_toStartOf="@+id/bt_settings_efectos"
        app:layout_constraintTop_toTopOf="@+id/bt_settings_set"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/bt_settings_efectos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Efectos"
        app:layout_constraintBottom_toBottomOf="@+id/bt_settings_personajes"
        app:layout_constraintEnd_toEndOf="@+id/rv_settings"
        app:layout_constraintTop_toTopOf="@+id/bt_settings_personajes" />

</androidx.constraintlayout.widget.ConstraintLayout>